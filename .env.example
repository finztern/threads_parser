# Copy to .env and fill in real values. Never commit .env itself.

# Overrides config.yaml:store_endpoint if set. Under docker-compose the parser
# reaches the host collector via host.docker.internal (set in docker-compose.yml).
STORE_ENDPOINT=http://127.0.0.1:9000/store_items

LOG_LEVEL=INFO
# Same warning text is logged at most once per this many seconds (0 = off).
LOG_THROTTLE_SECONDS=30

# Only for scripts/anon_probe.py / tiktok_probe.py / threads_http_probe.py
# (research helpers): one proxy URL, e.g. http://user:pass@host:port
PROBE_PROXY=

# CPU cap for the container (must not exceed the host core count; 1 vCPU VPS -> 0.9)
# PARSER_CPUS=2.0
# Max simultaneous POSTs to the collector (lower it if the collector answers "connection refused" under bursts).
# STORE_CONCURRENCY=12

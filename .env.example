# Copy to .env and fill in real values. Never commit .env itself.

# Overrides config.yaml:store_endpoint if set. Under docker-compose the parser
# reaches the host collector via host.docker.internal (set in docker-compose.yml).
STORE_ENDPOINT=http://127.0.0.1:9000/store_items

LOG_LEVEL=INFO

# Only for scripts/anon_probe.py / tiktok_probe.py / threads_http_probe.py
# (research helpers): one proxy URL, e.g. http://user:pass@host:port
PROBE_PROXY=

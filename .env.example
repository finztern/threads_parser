# Copy to .env and fill in real values. Never commit .env itself.

# Overrides config.yaml:store_endpoint if set. Under docker-compose the parser
# reaches the host collector via host.docker.internal (set in docker-compose.yml).
STORE_ENDPOINT=http://127.0.0.1:9000/store_items

LOG_LEVEL=INFO

# One DIFFERENT vless:// line (whole string) per account, from your Trust.Zone
# subscription. Each goes to its own xray_account_N container.
VLESS_URI_ACCOUNT_1=
VLESS_URI_ACCOUNT_2=

# Copy to home/.env. VPS targets (user@host[:ssh_port], comma separated): one reverse tunnel per VPS.
BRIDGE_TARGETS=root@VPS2_IP,sashko@VPS1_IP
# Where the parsers on the VPS send data (the docker bridge gateway of the VPS) and where it goes at home.
BRIDGE_REMOTE_BIND=172.17.0.1:9000
BRIDGE_LOCAL=127.0.0.1:9000
# Own proxy from a subscription (vless:// and hysteria2:// links, plain or base64). The fastest node to your VPS is chosen
# automatically (measured through the real path to the SSH port) and re-checked every BRIDGE_RESELECT_MINUTES. The link
# holds your token: it stays here, never in git. Takes priority over BRIDGE_UPSTREAM_PROXY and vless.txt.
BRIDGE_SUBSCRIPTION_URL=https://example.com/your-subscription-link
BRIDGE_RESELECT_MINUTES=30
# Local SOCKS port of the container's Xray (legacy vless.txt mode, loopback only).
BRIDGE_SOCKS_PORT=10808
# Use a proxy that ALREADY runs on the home machine (e.g. the "fastest node" of a VPN client) instead of the vless link:
# socks5h://127.0.0.1:1080 or http://127.0.0.1:1081. Then vless.txt is not needed and the container starts no xray.
# BRIDGE_UPSTREAM_PROXY=socks5h://127.0.0.1:1080

# Copy to home/.env. VPS targets (user@host[:ssh_port], comma separated): one reverse tunnel per VPS.
BRIDGE_TARGETS=root@VPS2_IP,sashko@VPS1_IP
# Where the parsers on the VPS send data (the docker bridge gateway of the VPS) and where it goes at home.
BRIDGE_REMOTE_BIND=172.17.0.1:9000
BRIDGE_LOCAL=127.0.0.1:9000
# Local SOCKS port of the container's Xray (loopback only).
BRIDGE_SOCKS_PORT=10808
